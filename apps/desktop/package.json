{
  "name": "morning-read",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,app \"vite\" \"wait-on http://127.0.0.1:6183 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:6183 electron .\"",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.js --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.js --external:electron",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run build:electron"
  },
  "dependencies": {
    "@remotion/lottie": "^4.0.534",
    "@remotion/player": "^4.0.534",
    "lottie-web": "^5.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
